# Servir archivos estáticos directamente desde staticfiles
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Bypasear Passenger para archivos estáticos y media
    # Esto fuerza a que sea Apache quien sirva los archivos, no Python/Django
    RewriteCond %{REQUEST_URI} ^/media/ [OR]
    RewriteCond %{REQUEST_URI} ^/static/
    RewriteRule . - [E=DO_NOT_HAND_OFF_TO_PASSENGER:1]

    # Redirigir a las carpetas físicas reales dentro de 'public'
    RewriteRule ^static/(.*)$ public/static/$1 [L]
    RewriteRule ^media/(.*)$ public/media/$1 [L]
</IfModule>

# Configurar tipos MIME correctos
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>

# Habilitar compresión
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/css application/javascript text/html
</IfModule>

# Cache para archivos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
